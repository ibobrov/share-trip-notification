# Local development only. Copy to .env and replace placeholders.
DATABASE_DSN=postgres://postgres:<password>@localhost:6544/sharetrip-notification?sslmode=disable

# Runtime configuration
HTTP_PORT=4001
REQUEST_TIMEOUT_MS=2000
LOG_LEVEL=INFO
KAFKA_BROKERS=localhost:9092
KAFKA_TRIP_TOPIC=trip.events
KAFKA_GROUP_ID=notification-service
HANDLE_TIMEOUT_MS=10000

# Local Docker Compose and migrations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_DB=sharetrip-notification
POSTGRES_PORT=6544
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_DSN}

APP_ENV=local
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:14319
